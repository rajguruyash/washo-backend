# ───────────── WASHO website configuration ─────────────
# Copy to .env (never commit it). The Express server reads this file from the repo root.
# The website holds NO data of its own: Supabase is the one backend (database, Auth, edge functions, Storage).

# ── Server ──
# macOS reserves port 5000 for AirPlay Receiver, so use another port locally.
PORT=5001

# ── Supabase (use the project or a Supabase BRANCH; never point tests at production) ──
SUPABASE_URL=https://opjbxvpffrceibbuybiq.supabase.co
# The publishable (anon) key. Public by design. Never the service-role or secret key here.
SUPABASE_ANON_KEY=
# Legacy HS256 projects only: Project Settings → API → JWT secret. Leave empty on projects with asymmetric signing keys
# (the server then verifies sessions against the project's published keys).
SUPABASE_JWT_SECRET=
# SERVER ONLY. Used to store and sign wash photos after the database has confirmed the specialist holds that wash.
# Never put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=wash-photos

# ── Database: the Supabase SESSION POOLER (IPv4). Do not use the direct db.<ref>.supabase.co host: it is IPv6-only and Render cannot reach it. ──
# Replace [PASSWORD] with the database password (set it only in Render's environment, never in Git).
# Today this connects as the pooler's postgres user, which can act as `authenticated` for each request, exactly like the app does.
# After migration 20261004000003 is applied you may switch to the least-privilege role instead:
#   postgresql://washo_api.opjbxvpffrceibbuybiq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.opjbxvpffrceibbuybiq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# off | require | verify. Defaults to off for localhost and "require" elsewhere.
# DATABASE_SSL=require

# ── Email (optional: tells WASHO a membership request is waiting) ──
RESEND_API_KEY=
EMAIL_FROM=WASHO <notifications@washo.online>
ADMIN_EMAIL=contact.washo@gmail.com

# ── Razorpay Standard Checkout (server side). Set BOTH in the server's environment (Render). The secret never reaches the browser. ──
# Use rzp_test_… keys for testing, rzp_live_… for real money. Do not put the secret in Git or in the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you typed when adding the webhook in Razorpay (Settings → Webhooks → https://<site>/api/razorpay/webhook). Lets Razorpay record a payment even if the customer's browser never came back.
RAZORPAY_WEBHOOK_SECRET=

# ── Optional: the public address of the site, used by "Continue with Google" to tell Supabase where to send people back to ──
# Also add <this>/api/auth/callback to Supabase → Authentication → URL Configuration → Redirect URLs, and switch on the Google provider there.
# PUBLIC_URL=https://washo.online

# Not here, on purpose:
#  - Twilio: phone OTP is configured inside Supabase Auth (Twilio Verify).

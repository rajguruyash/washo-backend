{
  "name": "washo-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:start": "node backend/dist/server.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:baseline": "./supabase/tests/setup-baseline.sh",
    "db:test:baseline": "./supabase/tests/run.sh baseline",
    "db:test": "./supabase/tests/run.sh safe",
    "db:test:full": "./supabase/tests/run.sh full",
    "leads:import": "node -r ts-node/register/transpile-only supabase/scripts/import-leads.ts",
    "test:api": "./supabase/tests/run.sh api",
    "test:all": "npm run typecheck && npm test && npm run db:test && npm run db:test:full && npm run test:api",
    "backend:dev": "TS_NODE_PROJECT=backend/tsconfig.json node --watch -r ts-node/register/transpile-only backend/src/server.ts",
    "dev:stack": "./supabase/tests/run.sh dev",
    "db:bundle": "./supabase/bundles/build.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^14.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.51.0",
    "ogl": "^1.0.11",
    "pg": "^8.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "resend": "^6.25.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  }
}
